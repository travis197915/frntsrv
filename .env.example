# ── Identity service (Node `claims-corebackend`) ────────────────────────────
# Only used for /auth/register, /auth/login, /auth/me, /auth/change-password.
VITE_AUTH_API_BASE_URL=http://localhost:4000

# ── Builder service (Django `sop_backend/builder`) ──────────────────────────
# Workflows, the shape catalog, sidebar nav, dashboard widgets — i.e. every
# aspect of the UI that comes from the backend.  Trusts the JWT issued by the
# identity service via a shared JWT_SECRET.
VITE_BUILDER_API_BASE_URL=http://localhost:8000/api/builder

# ── Legacy backwards-compat — points the old VITE_API_BASE_URL at identity ──
# Removed once nothing reads it.
VITE_API_BASE_URL=http://localhost:4000

# ── Legacy GraphQL backend — still consumed by activity / ai-usage / users
# pages until those are migrated to REST.  Leave blank to disable.
VITE_GRAPHQL_BACKEND_URL=http://localhost:3000/graphql
VITE_GRAPHQL_CODEGEN_URL=http://localhost:3000/graphql
VITE_CLIENT_NAME=United Health Care
